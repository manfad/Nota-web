---
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
import { site } from "../config";
import appIcon from "../assets/icon.png";
import hero from "../assets/nota-split.png";
import FeatureShowcase from "../components/FeatureShowcase.astro";
import { getTranslation } from "../i18n";
import {
  defaultLocale,
  getLocale,
  locales,
  localePath,
  type Locale,
} from "../i18n/locales";
import "../styles/global.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const { htmlLang } = getLocale(locale);

const socialImage = Astro.site
  ? new URL("/social.png", Astro.site).href
  : "/social.png";
const hrefFor = (code: Locale) =>
  Astro.site ? new URL(localePath(code), Astro.site).href : localePath(code);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f6" />
    <meta name="description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={socialImage} />
    {Astro.site && <link rel="canonical" href={hrefFor(locale)} />}
    {
      locales.map((entry) => (
        <link
          rel="alternate"
          hreflang={entry.htmlLang}
          href={hrefFor(entry.code)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={hrefFor(defaultLocale)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/dm-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{t.meta.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <header class="site-header wrap">
      <a class="wordmark" href="#" aria-label={t.nav.home}
        ><Image src={appIcon} alt="" width={40} height={40} />Nota<span
          class="mac-label">{t.nav.macLabel}</span
        ></a
      >
      <nav aria-label={t.nav.label}>
        <a class="nav-text" href="#features">{t.nav.features}</a>
        <a class="nav-text" href={site.repository}
          >{t.nav.github} <Icon name="arrow" size={13} /></a
        >
        <LanguagePicker locale={locale} />
        <a class="button button-small" href={site.download}
          >{t.nav.download} <Icon name="arrow" size={15} /></a
        >
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-heading">
        <div class="eyebrow">
          <span class="status-dot"></span>{t.hero.eyebrow}
        </div>
        <h1 id="hero-heading">
          {t.hero.heading[0]}<br /><span>{t.hero.heading[1]}</span>
        </h1>
        <p class="hero-description">
          {t.hero.description[0]}<br class="desktop-break" /> {
            t.hero.description[1]
          }
        </p>
        <div class="hero-actions">
          <a class="button" href={site.download}
            ><Icon name="apple" size={22} />{t.hero.download}</a
          ><a class="text-link" href={site.repository}
            >{t.hero.viewSource} <Icon name="arrow" size={16} /></a
          >
        </div>
        <p class="compatibility">
          {t.hero.compatibility}
          <span>·</span> {t.hero.noAccount}
        </p>

        <figure class="hero-figure">
          <div class="screenshot-stage">
            <Image
              class="app-screenshot"
              src={hero}
              alt={t.hero.screenshotAlt}
              widths={[640, 960, 1280, 1920, 2300]}
              sizes="(max-width: 720px) calc(100vw - 48px), (max-width: 1200px) 88vw, 1064px"
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </figure>
      </section>

      <FeatureShowcase t={t} />

      <section
        id="open-source"
        class="open-section"
        aria-labelledby="open-heading"
      >
        <div class="wrap open-inner">
          <div>
            <p class="eyebrow">{t.openSource.eyebrow}</p><h2 id="open-heading">
              {t.openSource.heading[0]}<br />{t.openSource.heading[1]}
            </h2><p>
              {t.openSource.description}
            </p><a class="text-link" href={site.repository}
              ><Icon name="github" size={19} />{t.openSource.link} <Icon
                name="arrow"
                size={16}
              /></a
            >
          </div><div class="values-list">
            {
              t.openSource.values.map((value) => (
                <div>
                  <span>{value.number}</span>
                  <p>
                    <strong>{value.title}</strong>
                    {value.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="closing wrap" aria-labelledby="closing-heading">
        <Image
          src={appIcon}
          alt={t.closing.iconAlt}
          width={88}
          height={88}
          loading="lazy"
        /><h2 id="closing-heading">
          {t.closing.heading[0]}<br />{t.closing.heading[1]}
        </h2><p>
          {t.closing.description}
        </p><a class="button" href={site.download}
          ><Icon name="apple" size={22} />{t.closing.download}</a
        ><span class="compatibility">{t.closing.compatibility}</span>
      </section>
    </main>
    <footer class="site-footer wrap">
      <a class="wordmark" href="#" aria-label={t.footer.home}
        ><Image src={appIcon} alt="" width={28} height={28} />Nota</a
      ><p>{t.footer.tagline}</p><a href={site.repository}
        >{t.footer.link} <Icon name="arrow" size={14} /></a
      >
    </footer>
  </body>
</html>

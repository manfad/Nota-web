---
import { Image } from "astro:assets";
import editor from "../assets/nota-editor.png";
import images from "../assets/nota-images.png";
import preview from "../assets/nota-split.png";
import quiet from "../assets/nota-quiet.png";
import book from "../assets/nota-book.png";
import vim from "../assets/nota-vim.png";
import type { Translation } from "../i18n/en";

interface Props {
  t: Translation;
}

const { t } = Astro.props;

/** Screenshot for each feature, in the same order as the dictionary. */
const featureImages = [editor, images, preview, quiet, vim, editor, book, editor];

const features = t.showcase.features.map((feature, index) => ({
  ...feature,
  image: featureImages[index] ?? editor,
}));
const initialIndex = 0;
const offsetFor = (index: number) =>
  ((index - initialIndex + features.length + Math.floor(features.length / 2)) %
    features.length) -
  Math.floor(features.length / 2);
---

<section
  id="features"
  class="feature-showcase wrap"
  aria-labelledby="features-heading"
>
  <header class="showcase-heading">
    <div>
      <p class="eyebrow">{t.showcase.eyebrow}</p><h2
        id="features-heading"
      >
        {t.showcase.heading}
      </h2>
    </div>
  </header>

  <div
    class="showcase-shell"
    data-showcase
    data-announcement={t.showcase.announcement}
  >
    <div class="showcase-selector">
      <div class="wheel-window">
        <div
          class="feature-wheel"
          role="tablist"
          aria-label={t.showcase.listLabel}
          aria-orientation="vertical"
        >
          {
            features.map((feature, index) => {
              const offset = offsetFor(index);
              return (
                <button
                  type="button"
                  role="tab"
                  class="wheel-tab"
                  id={`feature-tab-${index}`}
                  aria-controls={`feature-panel-${index}`}
                  aria-selected={index === initialIndex}
                  tabindex={index === initialIndex ? 0 : -1}
                  data-index={index}
                  data-distance={Math.abs(offset)}
                  style={`--offset: ${offset}; --scale: ${1 - Math.min(Math.abs(offset), 3) * 0.13};`}
                >
                  <span>{feature.name}</span>
                </button>
              );
            })
          }
        </div>
      </div>

      <div class="feature-descriptions">
        {
          features.map((feature, index) => (
            <div
              class="feature-description"
              id={`feature-description-${index}`}
              data-description={index}
              aria-hidden={index !== initialIndex}
            >
              <>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>

    <p class="sr-only" role="status" data-announcement></p>
    <div class="feature-panels">
      {
        features.map((feature, index) => (
          <div
            class="feature-panel"
            id={`feature-panel-${index}`}
            role="tabpanel"
            aria-labelledby={`feature-tab-${index}`}
            aria-describedby={`feature-description-${index}`}
            aria-hidden={index !== initialIndex}
            inert={index !== initialIndex}
            tabindex="0"
            data-panel={index}
          >
            <figure>
              <div class="feature-image-stage">
                <Image
                  src={feature.image}
                  alt={feature.alt}
                  widths={[640, 1000, 1600, 2000]}
                  sizes="(max-width: 740px) 90vw, (max-width: 1200px) 54vw, 660px"
                  format="webp"
                  loading="lazy"
                />
              </div>
              <figcaption>{feature.caption}</figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </div>

  <noscript>
    <style is:inline>
      .showcase-shell {
        display: none;
      }
    </style>
    <div class="feature-fallback">
      {
        features.map((feature) => (
          <details>
            <>
              <summary>{feature.name}</summary>
              <p>{feature.description}</p>
            </>
          </details>
        ))
      }
    </div>
  </noscript>
</section>

<script>
  const showcase = document.querySelector<HTMLElement>("[data-showcase]");
  if (showcase) {
    const tabs = [
      ...showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    ];
    const panels = [...showcase.querySelectorAll<HTMLElement>("[data-panel]")];
    const descriptions = [
      ...showcase.querySelectorAll<HTMLElement>("[data-description]"),
    ];
    const wheelWindow = showcase.querySelector<HTMLElement>(".wheel-window")!;
    const announcement = showcase.querySelector<HTMLElement>(
      "[data-announcement]",
    )!;
    const copy = showcase.dataset;
    let active = 0;

    function select(index: number, manual = false) {
      active = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const selected = i === active;
        const offset =
          ((i - active + tabs.length + Math.floor(tabs.length / 2)) %
            tabs.length) -
          Math.floor(tabs.length / 2);
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        tab.dataset.distance = String(Math.abs(offset));
        tab.style.setProperty("--offset", String(offset));
        tab.style.setProperty(
          "--scale",
          String(1 - Math.min(Math.abs(offset), 3) * 0.13),
        );
        panels[i].setAttribute("aria-hidden", String(!selected));
        panels[i].inert = !selected;
        descriptions[i].setAttribute("aria-hidden", String(!selected));
      });
      if (manual && document.activeElement?.getAttribute("role") !== "tab") {
        announcement.textContent = (copy.announcement ?? "")
          .replace("{name}", tabs[active].textContent?.trim() ?? "")
          .replace("{index}", String(active + 1))
          .replace("{total}", String(tabs.length))
          .replace(
            "{description}",
            descriptions[active].textContent?.trim() ?? "",
          );
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index, true));
      tab.addEventListener("keydown", (event) => {
        let next: number;
        switch (event.key) {
          case "ArrowDown":
            next = active + 1;
            break;
          case "ArrowUp":
            next = active - 1;
            break;
          case "Home":
            next = 0;
            break;
          case "End":
            next = tabs.length - 1;
            break;
          default:
            return;
        }
        event.preventDefault();
        select(next, true);
        tabs[active].focus({ preventScroll: true });
      });
    });

    /** Wheel distance that adds up to one step, and the quiet time after it. */
    const WHEEL_THRESHOLD = 60;
    const STEP_COOLDOWN = 350;
    let wheelDelta = 0;
    let lastStep = 0;

    function step(direction: number) {
      wheelDelta = 0;
      lastStep = performance.now();
      select(active + direction, true);
    }

    wheelWindow.addEventListener(
      "wheel",
      (event) => {
        // The wheel owns vertical scrolling while the pointer is over it.
        event.preventDefault();
        if (performance.now() - lastStep < STEP_COOLDOWN) {
          wheelDelta = 0;
          return;
        }
        const lines = event.deltaMode === 1;
        const pages = event.deltaMode === 2;
        wheelDelta +=
          event.deltaY * (lines ? 16 : pages ? window.innerHeight : 1);
        if (Math.abs(wheelDelta) >= WHEEL_THRESHOLD) {
          step(wheelDelta > 0 ? 1 : -1);
        }
      },
      { passive: false },
    );

    /** Touch drags move one slide per 40px of travel. */
    const TOUCH_THRESHOLD = 40;
    let touchStart: number | null = null;

    wheelWindow.addEventListener(
      "touchstart",
      (event) => {
        touchStart = event.touches[0]?.clientY ?? null;
      },
      { passive: true },
    );
    wheelWindow.addEventListener(
      "touchmove",
      (event) => {
        if (touchStart === null) return;
        const current = event.touches[0]?.clientY;
        if (current === undefined) return;
        const delta = touchStart - current;
        if (Math.abs(delta) < TOUCH_THRESHOLD) return;
        event.preventDefault();
        touchStart = current;
        step(delta > 0 ? 1 : -1);
      },
      { passive: false },
    );
    wheelWindow.addEventListener("touchend", () => {
      touchStart = null;
    });
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .feature-showcase {
    padding-block: 68px 78px;
  }
  .showcase-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 29px;
  }
  .showcase-heading .eyebrow {
    justify-content: flex-start;
    font-size: 9px;
    margin-bottom: 13px;
  }
  .showcase-heading h2 {
    font-size: 32px;
    letter-spacing: -1.3px;
  }
  .showcase-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.45fr);
    gap: 44px;
    align-items: center;
    padding: 26px 32px 28px;
    background: #f3f1eb;
    border: 1px solid #e5e1d8;
    border-radius: 22px;
    min-height: 540px;
  }
  .showcase-selector {
    min-width: 0;
  }
  .wheel-window {
    overflow: hidden;
    margin-bottom: 26px;
    /* The wheel captures vertical wheel/touch gestures to change slides. */
    touch-action: pan-x;
    overscroll-behavior: contain;
    user-select: none;
  }
  .feature-wheel {
    position: relative;
    height: 270px;
    perspective: 700px;
  }
  .wheel-tab {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    border: none;
    background: transparent;
    padding: 6px 12px;
    min-height: 46px;
    color: var(--muted);
    text-align: center;
    font-size: 29px;
    line-height: 1.15;
    font-weight: 450;
    letter-spacing: -1px;
    white-space: nowrap;
    transform: translateY(calc(-50% + var(--offset) * 51px)) scale(var(--scale))
      rotateX(calc(var(--offset) * -9deg));
    opacity: 0.72;
  }
  .wheel-tab[aria-selected="true"] {
    font-weight: 550;
    color: var(--ink);
    opacity: 1;
  }
  .wheel-tab[data-distance="3"],
  .wheel-tab[data-distance="4"] {
    opacity: 0;
    pointer-events: none;
  }
  .wheel-tab:hover {
    color: var(--accent);
    opacity: 1;
  }
  .wheel-tab:focus-visible {
    outline-offset: -3px;
    border-radius: 7px;
  }
  .feature-descriptions {
    display: grid;
    margin-inline: 5px;
  }
  .feature-description {
    grid-area: 1 / 1;
  }
  .feature-description[aria-hidden="true"] {
    visibility: hidden;
    opacity: 0;
  }
  .feature-description h3 {
    font-size: 15px;
    font-weight: 550;
    letter-spacing: -0.25px;
    margin-bottom: 10px;
    line-height: 1.5;
  }
  .feature-description p {
    font-size: 12px;
    line-height: 1.9;
    color: var(--muted);
  }
  .feature-panels {
    display: grid;
    min-width: 0;
  }
  .feature-panel {
    grid-area: 1 / 1;
    min-width: 0;
    opacity: 1;
  }
  .feature-panel[aria-hidden="true"] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .feature-panel:focus-visible {
    outline-offset: 8px;
    border-radius: 8px;
  }
  .feature-image-stage {
    display: flex;
    align-items: center;
    aspect-ratio: 1.43;
    border-radius: 12px;
    padding: 17px;
    background: #e9e5dc;
  }
  .feature-image-stage img {
    width: 100%;
    height: auto;
    border-radius: 7px;
    outline: 1px solid #0000001a;
    box-shadow: 0 5px 22px #55452612;
  }
  .feature-panel figcaption {
    margin-top: 17px;
    font-size: 10px;
    color: #696358;
    text-wrap: balance;
  }
  .feature-fallback details {
    padding: 18px;
    border-bottom: 1px solid var(--line);
  }
  .feature-fallback summary {
    cursor: pointer;
    font-weight: 550;
  }
  .feature-fallback p {
    margin-top: 12px;
    line-height: 1.8;
    font-size: 14px;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .wheel-tab {
      transition:
        transform 650ms cubic-bezier(0.22, 0.68, 0, 1),
        opacity 450ms,
        color 180ms;
    }
    .feature-panel,
    .feature-description {
      transition:
        opacity 300ms ease-out,
        visibility 300ms;
    }
  }
  @media (max-width: 1000px) {
    .showcase-shell {
      gap: 22px;
      padding: 24px;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }
    .wheel-tab {
      font-size: 26px;
    }
    .feature-image-stage {
      padding: 12px;
    }
  }
  @media (max-width: 740px) {
    .feature-showcase {
      padding-block: 47px 52px;
    }
    .showcase-heading {
      margin-bottom: 24px;
    }
    .showcase-heading h2 {
      font-size: 27px;
    }
    .showcase-shell {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 14px 22px 22px;
      min-height: 0;
      border-radius: 17px;
    }
    .showcase-selector {
      max-width: 440px;
      margin-inline: auto;
      width: 100%;
    }
    .wheel-window {
      margin-bottom: 10px;
    }
    .feature-wheel {
      height: 222px;
    }
    .wheel-tab {
      font-size: 28px;
      transform: translateY(calc(-50% + var(--offset) * 44px))
        scale(var(--scale)) rotateX(calc(var(--offset) * -9deg));
    }
    .feature-description h3 {
      font-size: 14px;
      margin-bottom: 6px;
    }
    .feature-description p {
      font-size: 12px;
      line-height: 1.75;
    }
    .feature-image-stage {
      aspect-ratio: 1.75;
      padding: 10px;
      border-radius: 9px;
    }
    .feature-image-stage img {
      border-radius: 4px;
    }
    .feature-panel figcaption {
      margin-top: 11px;
      font-size: 9px;
    }
  }
  @media (max-width: 380px) {
    .showcase-shell {
      padding-inline: 15px;
    }
    .showcase-heading h2 {
      font-size: 25px;
    }
    .wheel-tab {
      font-size: 25px;
    }
  }
</style>
